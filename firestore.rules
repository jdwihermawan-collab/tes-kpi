rules_version = '2';

// ============================================================
// Firestore Rules LENGKAP untuk Lead Tracker (CRM PRN).
// Cara pasang: Firebase Console > Firestore Database > Rules >
// hapus SEMUA isi lama > tempel seluruh file ini > Publish.
//
// Role (users/{uid}.role): 'SuperAdmin' | 'Admin' (SPV/Manager) | 'CS' | 'Marketing'
// Akun nonaktif (active == false) tidak bisa membaca/menulis apa pun selain profilnya sendiri.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return hasProfile() && me().get('active', true) != false; }
    function isSuper() { return isActive() && me().role == 'SuperAdmin'; }
    function isStaff() { return isActive() && me().role in ['CS', 'Admin', 'SuperAdmin']; }
    function isMarketing() { return isActive() && me().role == 'Marketing'; }
    function myName() { return me().name; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // ---------- Profil akun ----------
    match /users/{uid} {
      // Setiap akun boleh membaca profilnya sendiri (dipakai saat login, termasuk
      // untuk menampilkan pesan "akun dinonaktifkan"). CS/SPV/Super Admin membaca semua.
      allow read: if isSelf(uid) || isStaff();
      allow create, update: if isSuper();
      allow delete: if isSuper() && !isSelf(uid);   // Hapus Permanen
    }

    // ---------- Password tersimpan (khusus Super Admin) ----------
    match /credentials/{uid} {
      allow read, write: if isSuper();
    }

    // ---------- Pengaturan: settings/projects & settings/adRotation ----------
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isSuper() || (isStaff() && docId == 'adRotation');
    }

    // ---------- Lead ----------
    match /leads/{leadId} {
      // CS / SPV / Super Admin: akses penuh (input, pengalihan "Terima Lead", hapus).
      allow read, create, update, delete: if isStaff();

      // Marketing: hanya lead miliknya sendiri, tidak boleh memindahkan lead ke orang lain,
      // dan tidak boleh mengubah penanda isSelfInput (penanda lead Input Mandiri).
      allow read: if isMarketing() && resource.data.assignedTo == myName();
      allow create: if isMarketing() && request.resource.data.assignedTo == myName();
      allow update: if isMarketing()
        && resource.data.assignedTo == myName()
        && request.resource.data.assignedTo == myName()
        && request.resource.data.get('isSelfInput', false) == resource.data.get('isSelfInput', false);
      // Marketing hanya boleh menghapus lead Input Mandiri miliknya sendiri.
      // Lead dari CS / iklan tidak bisa dihapus marketing (ubah status ke "Lost (Batal)").
      allow delete: if isMarketing()
        && resource.data.assignedTo == myName()
        && resource.data.get('isSelfInput', false) == true;
    }

    // ---------- Indeks nomor WA (cek duplikat lintas tim) ----------
    // Semua akun aktif boleh mengecek SATU nomor (get) dan mencatat lead-nya sendiri.
    // Melihat seluruh daftar nomor (list) dan menghapus entri hanya untuk CS/SPV/Super Admin.
    match /waIndex/{waDigits} {
      allow get: if isActive();
      allow create, update: if isActive();
      allow list, delete: if isStaff();
    }

    // ---------- Nomor spam dari iklan (dicatat CS lewat tab "Input Spam") ----------
    // Tidak masuk ke marketing; dilihat CS & SPV di Riwayat. Hapus untuk koreksi salah input.
    match /spamNumbers/{spamId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.createdByUid == request.auth.uid;
      allow delete: if isStaff();
    }

    // ---------- Aktivitas marketing ----------
    match /marketingActivity/{uid} {
      allow read: if isStaff() || isSelf(uid);
      allow create, update: if isMarketing() && isSelf(uid);
      allow delete: if isSuper();                   // Hapus Permanen

      match /logs/{logId} {
        allow read: if isStaff() || isSelf(uid);
        allow create: if isMarketing() && isSelf(uid);
        allow delete: if isSuper();                 // Hapus Permanen
      }
    }

    // ---------- Laporan KPI Online/Offline (Live TikTok / Canvasing) ----------
    // kpiReports/{uid}/kpiItems/{id}: ditulis marketing sendiri, dibaca SPV/Super Admin untuk KPI.
    match /kpiReports/{uid}/kpiItems/{itemId} {
      allow read: if isStaff() || (isSelf(uid) && isActive());
      allow create: if isMarketing() && isSelf(uid)
        && request.resource.data.type in ['Live TikTok', 'Canvasing']
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300;
      allow delete: if isSuper() || (isMarketing() && isSelf(uid));
    }

    // ---------- Log pengingat WA ----------
    match /reminderLogs/{logId} {
      allow read, create: if isStaff();
      allow delete: if isSuper();                   // Hapus Permanen
    }

    // ---------- Token Push Notification ----------
    // Server (api/send-push.js) memakai Admin SDK sehingga tidak terpengaruh rules ini.
    match /pushTokens/{uid} {
      allow read, write: if isSelf(uid) && isActive();
      allow read: if isSuper();
    }
  }
}
